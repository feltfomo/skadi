@OBSThemeMeta {
    name: 'Reactive';
    id: 'org.skadi.Reactive';
    extends: 'com.obsproject.Yami';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: {{ colors.outline.default.hex }};
    --grey2: {{ colors.outline_variant.default.hex }};
    --grey3: {{ colors.surface_container_highest.default.hex }};
    --grey4: {{ colors.surface_container_high.default.hex }};
    --grey5: {{ colors.surface_container.default.hex }};
    --grey6: {{ colors.surface.default.hex }};
    --grey7: {{ colors.surface_dim.default.hex }};
    --grey8: {{ colors.shadow.default.hex }};
    --blue1: {{ colors.primary.default.hex }};
    --blue2: {{ colors.primary_container.default.hex }};
    --blue3: {{ colors.primary.default.hex }};
    --blue4: {{ colors.on_primary_container.default.hex }};
    --blue5: {{ colors.on_primary.default.hex }};
    --primary: {{ colors.primary.default.hex }};
    --primary_light: {{ colors.primary.default.hex }};
    --primary_lighter: {{ colors.primary.default.hex }};
    --primary_dark: {{ colors.primary_container.default.hex }};
    --primary_darker: {{ colors.on_primary.default.hex }};
    --bg_window: {{ colors.surface_dim.default.hex }};
    --bg_base: {{ colors.surface.default.hex }};
    --bg_preview: {{ colors.shadow.default.hex }};
    --text: {{ colors.on_surface.default.hex }};
    --text_light: {{ colors.on_surface_variant.default.hex }};
    --text_muted: {{ colors.on_surface_variant.default.hex }};
    --text_disabled: {{ colors.outline.default.hex }};
    --text_inactive: {{ colors.on_surface_variant.default.hex }};
    --warning: {{ colors.tertiary.default.hex }};
    --danger: {{ colors.error.default.hex }};
    --highlight_color: {{ colors.primary.default.hex }};
}
