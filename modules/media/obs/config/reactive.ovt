@OBSThemeMeta {
    name: 'Reactive';
    id: 'org.skadi.Reactive';
    extends: 'com.obsproject.Yami';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: {{ outline }};
    --grey2: {{ outlineVariant }};
    --grey3: {{ surfaceContainerHighest }};
    --grey4: {{ surfaceContainerHigh }};
    --grey5: {{ surfaceContainer }};
    --grey6: {{ surface }};
    --grey7: {{ surfaceDim }};
    --grey8: {{ shadow }};
    --blue1: {{ primary }};
    --blue2: {{ primaryContainer }};
    --blue3: {{ primary }};
    --blue4: {{ onPrimaryContainer }};
    --blue5: {{ onPrimary }};
    --primary: {{ primary }};
    --primary_light: {{ primary }};
    --primary_lighter: {{ primary }};
    --primary_dark: {{ primaryContainer }};
    --primary_darker: {{ onPrimary }};
    --bg_window: {{ surfaceDim }};
    --bg_base: {{ surface }};
    --bg_preview: {{ shadow }};
    --text: {{ onSurface }};
    --text_light: {{ onSurfaceVariant }};
    --text_muted: {{ onSurfaceVariant }};
    --text_disabled: {{ outline }};
    --text_inactive: {{ onSurfaceVariant }};
    --warning: {{ warning }};
    --danger: {{ error }};
    --highlight_color: {{ primary }};
}
