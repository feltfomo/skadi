@OBSThemeMeta {
    name: 'Reactive';
    id: 'org.skadi.Reactive';
    extends: 'com.obsproject.Yami';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: #{{ outline.hex }};
    --grey2: #{{ outlineVariant.hex }};
    --grey3: #{{ surfaceContainerHighest.hex }};
    --grey4: #{{ surfaceContainerHigh.hex }};
    --grey5: #{{ surfaceContainer.hex }};
    --grey6: #{{ surface.hex }};
    --grey7: #{{ surfaceDim.hex }};
    --grey8: #{{ shadow.hex }};
    --blue1: #{{ primary.hex }};
    --blue2: #{{ primaryContainer.hex }};
    --blue3: #{{ primary.hex }};
    --blue4: #{{ onPrimaryContainer.hex }};
    --blue5: #{{ onPrimary.hex }};
    --primary: #{{ primary.hex }};
    --primary_light: #{{ primary.hex }};
    --primary_lighter: #{{ primary.hex }};
    --primary_dark: #{{ primaryContainer.hex }};
    --primary_darker: #{{ onPrimary.hex }};
    --bg_window: #{{ surfaceDim.hex }};
    --bg_base: #{{ surface.hex }};
    --bg_preview: #{{ shadow.hex }};
    --text: #{{ onSurface.hex }};
    --text_light: #{{ onSurfaceVariant.hex }};
    --text_muted: #{{ onSurfaceVariant.hex }};
    --text_disabled: #{{ outline.hex }};
    --text_inactive: #{{ onSurfaceVariant.hex }};
    --warning: #{{ term3.hex }};
    --danger: #{{ error.hex }};
    --highlight_color: #{{ primary.hex }};
}
