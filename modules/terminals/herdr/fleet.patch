+                    status,
+                    stdout: std::mem::take(stdout),
+                    stderr: std::mem::take(stderr),
+                });
+            }
+            if Instant::now() >= deadline {
+                return Err(io::Error::new(
+                    io::ErrorKind::TimedOut,
+                    "remote setup command timed out",
+                ));
+            }
+            thread::sleep(Duration::from_millis(10));
+        }
