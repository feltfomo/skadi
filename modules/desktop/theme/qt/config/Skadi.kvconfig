[%General]
comment=Wallpaper-tinted panels and compact square controls
respect_DE=true
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
click_behavior=0
left_tabs=true
joined_inactive_tabs=false
attach_active_tab=false
active_tab_overlap=0
group_toolbar_buttons=false
composite=false
translucent_windows=false
blurring=false
popup_blurring=false
animate_states=false
combo_as_lineedit=true
combo_focus_rect=true
inline_spin_indicators=true
scroll_width=12
scroll_min_extent=36
scroll_arrows=true
transient_scrollbar=false
slider_width=6
slider_handle_width=16
slider_handle_length=16
splitter_width=7
check_size=16
tooltip_delay=-1

[GeneralColors]
window.color=@shell@
inactive.window.color=@shell@
base.color=@field@
inactive.base.color=@field@
alt.base.color=@panel@
inactive.alt.base.color=@panel@
button.color=@panel@
light.color=@strong_border@
mid.light.color=@border@
dark.color=@shell@
mid.color=@border@
highlight.color=@primary@
inactive.highlight.color=@primary@
tooltip.base.color=@panel@
text.color=@on_surface@
window.text.color=@on_surface@
button.text.color=@on_surface@
disabled.text.color=@disabled_text@
inactive.text.color=@on_surface_variant@
inactive.window.text.color=@on_surface_variant@
highlight.text.color=@on_primary@
inactive.highlight.text.color=@on_primary@
tooltip.text.color=@on_surface@
link.color=@primary@
link.visited.color=@tertiary@
progress.indicator.text.color=@on_primary@
progress.inactive.indicator.text.color=@on_primary@

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
focusFrame=true
interior=true
interior.element=button
indicator.element=arrow
indicator.size=8
text.normal.color=@on_surface@
text.focus.color=@on_surface@
text.press.color=@on_surface@
text.toggle.color=@on_primary@
text.normal.inactive.color=@on_surface_variant@
text.focus.inactive.color=@on_surface@
text.press.inactive.color=@on_surface@
text.toggle.inactive.color=@on_primary@
text.margin=true
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8
text.iconspacing=4
text.shadow=false
text.bold=false
text.italic=false

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=toolbutton
interior.element=toolbutton
text.margin.left=4
text.margin.right=4

[ToolbarButton]
inherits=PanelButtonTool

[ToolbarComboBox]
inherits=ComboBox

[ToolbarLineEdit]
inherits=LineEdit

[Dock]
inherits=GenericFrame
interior=true
interior.element=panel

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=panel
text.toggle.color=@on_surface@

[IndicatorSpinBox]
inherits=PanelButtonTool
frame.element=button
interior.element=button
indicator.element=arrow

[RadioButton]
frame=false
interior=true
interior.element=radio
text.margin=true
text.margin.top=4
text.margin.bottom=4
text.margin.left=4
text.margin.right=4

[CheckBox]
inherits=RadioButton
interior.element=checkbox

[Focus]
frame=true
frame.element=focus
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=false

[GenericFrame]
frame=true
frame.element=field
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=false

[LineEdit]
inherits=GenericFrame
interior=true
interior.element=field
text.color=@on_surface@
text.margin=true
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=8

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
indicator.size=16
text.press.color=@on_primary@
text.press.inactive.color=@on_primary@
text.margin.left=8
text.margin.right=8

[TabFrame]
inherits=GenericFrame
frame.element=panel
interior=true
interior.element=panel

[TabBarFrame]
inherits=TabFrame
frame=false

[TreeExpander]
frame=false
interior=false
indicator.element=tree
indicator.size=10

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
text.toggle.color=@on_surface@
text.toggle.inactive.color=@on_surface@

[SizeGrip]
indicator.element=sizegrip
indicator.size=12

[Toolbar]
frame=false
interior=true
interior.element=shell
indicator.element=toolbar
indicator.size=6
text.normal.color=@on_surface@
text.normal.inactive.color=@on_surface_variant@

[MenuBar]
inherits=Toolbar

[Slider]
inherits=GenericFrame
frame.element=groove
interior=true
interior.element=groove

[SliderCursor]
inherits=PanelButtonCommand
frame.element=handle
interior.element=handle

[Progressbar]
inherits=GenericFrame
frame.element=groove
interior=true
interior.element=groove
text.normal.color=@on_surface@
text.focus.color=@on_surface@
text.normal.inactive.color=@on_surface_variant@
text.focus.inactive.color=@on_surface_variant@
text.press.color=@on_primary@
text.toggle.color=@on_primary@

[ProgressbarContents]
inherits=GenericFrame
frame.element=progress
interior=true
interior.element=progress

[ItemView]
inherits=PanelButtonCommand
frame.element=item
interior.element=item
focusFrame=false
text.press.color=@on_primary@
text.toggle.color=@on_primary@
text.press.inactive.color=@on_primary@
text.toggle.inactive.color=@on_primary@
text.margin=false

[Splitter]
frame=false
interior=true
interior.element=shell
indicator.element=splitter
indicator.size=12

[Scrollbar]
inherits=PanelButtonTool
indicator.element=arrow
indicator.size=8

[ScrollbarSlider]
inherits=GenericFrame
frame.element=scrollbar
interior=true
interior.element=scrollbar

[ScrollbarTransientSlider]
inherits=ScrollbarSlider

[ScrollbarGroove]
frame=false
interior=true
interior.element=field

[Menu]
inherits=GenericFrame
frame.element=popup
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=popup
text.normal.color=@on_surface@

[MenuItem]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
indicator.size=8
focusFrame=false
text.focus.color=@on_primary@
text.press.color=@on_primary@
text.toggle.color=@on_primary@
text.focus.inactive.color=@on_primary@
text.press.inactive.color=@on_primary@
text.toggle.inactive.color=@on_primary@

[MenuBarItem]
inherits=PanelButtonTool

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=shell
indicator.element=mdi
indicator.size=16
text.toggle.color=@on_surface@

[ComboBox]
inherits=PanelButtonCommand
frame.element=field
interior.element=field
text.press.color=@on_surface@
text.toggle.color=@on_surface@
text.press.inactive.color=@on_surface@
text.toggle.inactive.color=@on_surface@

[GroupBox]
inherits=GenericFrame
frame.element=card
frame.top=5
frame.bottom=5
frame.left=5
frame.right=5
interior=true
interior.element=card
text.normal.color=@on_surface@
text.margin=false

[ToolTip]
inherits=GenericFrame
frame.element=tooltip
interior=true
interior.element=tooltip
text.normal.color=@on_surface@
text.margin=false

[Window]
frame=false
interior=true
interior.element=shell

[Dialog]
inherits=Window
